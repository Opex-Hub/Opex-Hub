-- Opex Hub Universal Loader

local placeId = game.PlaceId
local hubUrl = nil

-- Correct place IDs extracted from your game URLs:
-- 1-Wings for Brainrots: placeId=84332574190497 (universeId=9998576154)
-- Climb and Jump Tower: placeId=123921593837160 (universeId=7474367816)

if placeId == 84332574190497 then
    hubUrl = "https://raw.githubusercontent.com/Opex-Hub/Opex-Hub/refs/heads/main/Opex%20Hub%20%7C%20%2B1%20wings%20for%20brainrots"
elseif placeId == 123921593837160 then
    hubUrl = "https://raw.githubusercontent.com/Opex-Hub/Opex-Hub/refs/heads/main/Opex%20Hub%20%7C%20Climb%20And%20Jump%20Tower"
end

if hubUrl then
    -- Notify the user that loading has started
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Opex Hub",
        Text = "Loading supported script...",
        Duration = 3
    })
    loadstring(game:HttpGet(hubUrl))()
else
    -- Black screen with white "NOT SUPPORTED" text for 5 seconds
    local player = game.Players.LocalPlayer
    if player and player.PlayerGui then
        local screenGui = Instance.new("ScreenGui")
        screenGui.Parent = player.PlayerGui
        screenGui.ResetOnSpawn = false

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundColor3 = Color3.new(0, 0, 0)
        frame.Parent = screenGui

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = "GAME NOT SUPPORTED"
        textLabel.TextColor3 = Color3.new(1, 1, 1)
        textLabel.TextSize = 60
        textLabel.Font = Enum.Font.GothamBold
        textLabel.TextStrokeTransparency = 0
        textLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        textLabel.Parent = frame
    end

    wait(5)

    -- Remove the black screen after 5 seconds
    if player and player.PlayerGui then
        for _, gui in pairs(player.PlayerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Name == "" and #gui:GetChildren() == 1 and gui:FindFirstChildWhichIsA("Frame") then
                gui:Destroy()
            end
        end
    end
end
