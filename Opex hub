-- Opex Hub Universal Loader

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local placeId = game.PlaceId
local hubUrl = nil

-- ═══════════════════════════════════════════════════════
-- BLOX FRUITS DETECTION (multi-method)
-- ═══════════════════════════════════════════════════════
local function isBloxFruits()
    local knownPlaces = { 2753915549, 4442272183, 7449423635 }
    for _, id in ipairs(knownPlaces) do
        if placeId == id then return true end
    end

    local isBF = false
    pcall(function()
        if game.UniverseId == 994732206 then isBF = true end
    end)
    if isBF then return true end

    local nameMatch = false
    pcall(function()
        local info = MarketplaceService:GetProductInfo(placeId)
        if info and info.Name then
            local n = string.lower(info.Name)
            if string.find(n, "blox") and string.find(n, "fruit") then
                nameMatch = true
            end
        end
    end)
    if nameMatch then return true end

    local hasFolder = false
    pcall(function()
        if game:GetService("ReplicatedStorage"):FindFirstChild("Remotes") then
            if game:GetService("ReplicatedStorage").Remotes:FindFirstChild("CommF_") then
                hasFolder = true
            end
        end
    end)
    if hasFolder then return true end

    return false
end

-- ═══════════════════════════════════════════════════════
-- PLACE ID & URL MATCHING
-- ═══════════════════════════════════════════════════════
if placeId == 84332574190497 then
    hubUrl = "https://raw.githubusercontent.com/Opex-Hub/Opex-Hub/refs/heads/main/Opex%20Hub%20%7C%20%2B1%20wings%20for%20brainrots"
elseif placeId == 123921593837160 then
    hubUrl = "https://raw.githubusercontent.com/Opex-Hub/Opex-Hub/refs/heads/main/Opex%20Hub%20%7C%20Climb%20And%20Jump%20Tower"
elseif placeId == 142823291 then
    hubUrl = "https://raw.githubusercontent.com/Opex-Hub/Opex-Hub/refs/heads/main/MM2"
elseif placeId == 126884695634066 then
    hubUrl = "https://raw.githubusercontent.com/Opex-Hub/Opex-Hub/refs/heads/main/GROW%20A%20GARDEN"
elseif placeId == 76838459031868 then
    hubUrl = "https://raw.githubusercontent.com/Opex-Hub/Opex-Hub/refs/heads/main/copy"
elseif placeId == 125927821145949 then
    hubUrl = "https://raw.githubusercontent.com/Opex-Hub/Opex-Hub/refs/heads/main/mine.lua"
elseif isBloxFruits() then
    hubUrl = "https://raw.githubusercontent.com/Opex-Hub/Opex-Hub/refs/heads/main/FruitFinder"
end

-- Safely find parent UI container
local function getGuiParent()
    local success, res = pcall(function() return CoreGui end)
    if success and res then return res end
    return player:WaitForChild("PlayerGui")
end

if hubUrl then
    local guiParent = getGuiParent()

    -- ═══════════════════════════════════════════════════════
    -- FULL SCREEN LOADING UI (Black + Blue)
    -- ═══════════════════════════════════════════════════════
    local BLACK = Color3.fromRGB(8, 8, 10)
    local BLUE = Color3.fromRGB(0, 150, 255)

    local loaderGui = Instance.new("ScreenGui")
    loaderGui.Name = "OpexHubLoader"
    loaderGui.ResetOnSpawn = false
    loaderGui.DisplayOrder = 999
    loaderGui.IgnoreGuiInset = true
    loaderGui.Parent = guiParent

    -- FULL SCREEN black background
    local bgFrame = Instance.new("Frame")
    bgFrame.Size = UDim2.new(1, 0, 1, 0)
    bgFrame.Position = UDim2.new(0, 0, 0, 0)
    bgFrame.BackgroundColor3 = BLACK
    bgFrame.BackgroundTransparency = 1
    bgFrame.BorderSizePixel = 0
    bgFrame.Parent = loaderGui

    -- Intro fade to full black
    task.spawn(function()
        TweenService:Create(bgFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = 0
        }):Play()
    end)

    -- Centered panel scaled for full screen
    local panel = Instance.new("Frame")
    panel.AnchorPoint = Vector2.new(0.5, 0.5)
    panel.Size = UDim2.new(0, 720, 0, 280)  -- bigger panel
    panel.Position = UDim2.new(0.5, 0, 0.5, 0)
    panel.BackgroundColor3 = BLACK
    panel.BackgroundTransparency = 1
    panel.BorderSizePixel = 0
    panel.Parent = loaderGui

    local panelCorner = Instance.new("UICorner")
    panelCorner.CornerRadius = UDim.new(0, 16)
    panelCorner.Parent = panel

    local panelStroke = Instance.new("UIStroke")
    panelStroke.Color = BLUE
    panelStroke.Thickness = 2.5
    panelStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    panelStroke.Transparency = 1
    panelStroke.Parent = panel

    -- Title: "Thanks for using Opex Hub"
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -60, 0, 48)
    titleLabel.Position = UDim2.new(0, 30, 0, 55)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = "Thanks for using Opex Hub"
    titleLabel.TextColor3 = BLUE
    titleLabel.TextSize = 34
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextXAlignment = Enum.TextXAlignment.Center
    titleLabel.TextTransparency = 1
    titleLabel.Parent = panel

    -- Subtitle: "LOADING"
    local subtitleLabel = Instance.new("TextLabel")
    subtitleLabel.Size = UDim2.new(1, -60, 0, 22)
    subtitleLabel.Position = UDim2.new(0, 30, 0, 108)
    subtitleLabel.BackgroundTransparency = 1
    subtitleLabel.Text = "L O A D I N G"
    subtitleLabel.TextColor3 = Color3.fromRGB(150, 150, 160)
    subtitleLabel.TextSize = 14
    subtitleLabel.Font = Enum.Font.Code
    subtitleLabel.TextXAlignment = Enum.TextXAlignment.Center
    subtitleLabel.TextTransparency = 1
    subtitleLabel.Parent = panel

    -- Loading bar outline
    local barOutline = Instance.new("Frame")
    barOutline.Size = UDim2.new(1, -80, 0, 14)
    barOutline.Position = UDim2.new(0, 40, 0, 165)
    barOutline.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    barOutline.BackgroundTransparency = 1
    barOutline.BorderSizePixel = 0
    barOutline.Parent = panel

    local barOutlineCorner = Instance.new("UICorner")
    barOutlineCorner.CornerRadius = UDim.new(1, 0)
    barOutlineCorner.Parent = barOutline

    local barOutlineStroke = Instance.new("UIStroke")
    barOutlineStroke.Color = BLUE
    barOutlineStroke.Thickness = 1.5
    barOutlineStroke.Transparency = 1
    barOutlineStroke.Parent = barOutline

    -- Loading bar fill
    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new(0, 0, 1, 0)
    barFill.BackgroundColor3 = BLUE
    barFill.BorderSizePixel = 0
    barFill.Parent = barOutline

    local barFillCorner = Instance.new("UICorner")
    barFillCorner.CornerRadius = UDim.new(1, 0)
    barFillCorner.Parent = barFill

    -- Percentage
    local percentLabel = Instance.new("TextLabel")
    percentLabel.Size = UDim2.new(1, -60, 0, 22)
    percentLabel.Position = UDim2.new(0, 30, 0, 195)
    percentLabel.BackgroundTransparency = 1
    percentLabel.Text = "0%"
    percentLabel.TextColor3 = BLUE
    percentLabel.TextSize = 16
    percentLabel.Font = Enum.Font.Code
    percentLabel.TextXAlignment = Enum.TextXAlignment.Center
    percentLabel.TextTransparency = 1
    percentLabel.Parent = panel

    -- ═══════════════════════════════════════════════════════
    -- FADE IN (0.6s)
    -- ═══════════════════════════════════════════════════════
    task.wait(0.2)
    local fadeIn = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(panel, fadeIn, {BackgroundTransparency = 0.15}):Play()
    TweenService:Create(panelStroke, fadeIn, {Transparency = 0}):Play()
    TweenService:Create(barOutline, fadeIn, {BackgroundTransparency = 0}):Play()
    TweenService:Create(barOutlineStroke, fadeIn, {Transparency = 0.5}):Play()
    TweenService:Create(titleLabel, fadeIn, {TextTransparency = 0}):Play()
    TweenService:Create(subtitleLabel, fadeIn, {TextTransparency = 0}):Play()
    TweenService:Create(percentLabel, fadeIn, {TextTransparency = 0}):Play()
    task.wait(0.6)

    -- ═══════════════════════════════════════════════════════
    -- SLOWER LOADING BAR ANIMATION (0 → 100% in ~2.4 seconds)
    -- ═══════════════════════════════════════════════════════
    local steps = 60
    local totalDuration = 2.4
    for i = 1, steps do
        local progress = i / steps
        barFill.Size = UDim2.new(progress, 0, 1, 0)
        percentLabel.Text = math.floor(progress * 100) .. "%"
        task.wait(totalDuration / steps)
    end

    -- Hold at 100% briefly
    task.wait(0.4)

    -- ═══════════════════════════════════════════════════════
    -- FADE OUT (0.6s)
    -- ═══════════════════════════════════════════════════════
    local fadeOut = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    TweenService:Create(panel, fadeOut, {BackgroundTransparency = 1}):Play()
    TweenService:Create(panelStroke, fadeOut, {Transparency = 1}):Play()
    TweenService:Create(barOutline, fadeOut, {BackgroundTransparency = 1}):Play()
    TweenService:Create(barOutlineStroke, fadeOut, {Transparency = 1}):Play()
    TweenService:Create(titleLabel, fadeOut, {TextTransparency = 1}):Play()
    TweenService:Create(subtitleLabel, fadeOut, {TextTransparency = 1}):Play()
    TweenService:Create(percentLabel, fadeOut, {TextTransparency = 1}):Play()
    TweenService:Create(barFill, fadeOut, {BackgroundTransparency = 1}):Play()
    TweenService:Create(bgFrame, fadeOut, {BackgroundTransparency = 1}):Play()
    task.wait(0.7)

    loaderGui:Destroy()

    -- Load Target Script
    loadstring(game:HttpGet(hubUrl))()

else
    -- Game Not Supported screen
    local playerGui = player and player:FindFirstChild("PlayerGui")
    if playerGui then
        local unsupportedGui = Instance.new("ScreenGui")
        unsupportedGui.Name = "OpexHubUnsupported"
        unsupportedGui.Parent = playerGui
        unsupportedGui.ResetOnSpawn = false
        unsupportedGui.IgnoreGuiInset = true

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundColor3 = Color3.new(0, 0, 0)
        frame.Parent = unsupportedGui

        local textLabel = Instance.new("TextLabel")
