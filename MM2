local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")

-- Remove existing instance if running re-entry
if playerGui:FindFirstChild("UpdatingOverlay") then
    playerGui.UpdatingOverlay:Destroy()
end

-- ScreenGui Setup (Full Screen 1:1)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "UpdatingOverlay"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true -- Covers top topbar / safe area
screenGui.DisplayOrder = 999
screenGui.Parent = playerGui

-- Background Frame
local bg = Instance.new("Frame")
bg.Size = UDim2.new(1, 0, 1, 0)
bg.BackgroundColor3 = Color3.fromRGB(15, 23, 42) -- #0f172a
bg.BorderSizePixel = 0
bg.Parent = screenGui

-- Main Container
local container = Instance.new("Frame")
container.Size = UDim2.new(0, 400, 0, 200)
container.AnchorPoint = Vector2.new(0.5, 0.5)
container.Position = UDim2.new(0.5, 0, 0.5, 0)
container.BackgroundTransparency = 1
container.Parent = bg

-- Spinner Ring
local spinner = Instance.new("Frame")
spinner.Size = UDim2.new(0, 48, 0, 48)
spinner.AnchorPoint = Vector2.new(0.5, 0)
spinner.Position = UDim2.new(0.5, 0, 0, 0)
spinner.BackgroundTransparency = 1
spinner.Parent = container

local spinnerUIStroke = Instance.new("UIStroke")
spinnerUIStroke.Thickness = 4
spinnerUIStroke.Color = Color3.fromRGB(56, 189, 248) -- #38bdf8
spinnerUIStroke.Parent = spinner

local spinnerUICorner = Instance.new("UICorner")
spinnerUICorner.CornerRadius = UDim.new(1, 0)
spinnerUICorner.Parent = spinner

-- Continuous Rotation
task.spawn(function()
    while spinner and spinner.Parent do
        spinner.Rotation = spinner.Rotation + 6
        task.wait(0.016)
    end
end)

-- Title Label
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 36)
title.Position = UDim2.new(0, 0, 0, 64)
title.Text = "Script Updating"
title.TextColor3 = Color3.fromRGB(248, 250, 252)
title.TextSize = 24
title.Font = Enum.Font.SourceSansBold
title.BackgroundTransparency = 1
title.Parent = container

-- Subtitle Label
local subtitle = Instance.new("TextLabel")
subtitle.Size = UDim2.new(1, 0, 0, 24)
subtitle.Position = UDim2.new(0, 0, 0, 100)
subtitle.Text = "THE SCRIPT IS UPDATING  
IT MIGHT BE DONE IN 5 DAYS OR LESS"
subtitle.TextColor3 = Color3.fromRGB(148, 163, 184)
subtitle.TextSize = 15
subtitle.Font = Enum.Font.SourceSans
subtitle.BackgroundTransparency = 1
subtitle.Parent = container

-- Progress Bar Background
local barBg = Instance.new("Frame")
barBg.Size = UDim2.new(1, 0, 0, 6)
barBg.Position = UDim2.new(0, 0, 0, 145)
barBg.BackgroundColor3 = Color3.fromRGB(30, 41, 59)
barBg.BorderSizePixel = 0
barBg.Parent = container

local barBgCorner = Instance.new("UICorner")
barBgCorner.CornerRadius = UDim.new(0, 3)
barBgCorner.Parent = barBg

-- Progress Fill
local fill = Instance.new("Frame")
fill.Size = UDim2.new(0.3, 0, 1, 0)
fill.BackgroundColor3 = Color3.fromRGB(56, 189, 248)
fill.BorderSizePixel = 0
fill.Parent = barBg

local fillCorner = Instance.new("UICorner")
fillCorner.CornerRadius = UDim.new(0, 3)
fillCorner.Parent = fill

-- Pulse Animation for Progress Bar
local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
local pulseTween = TweenService:Create(fill, tweenInfo, { BackgroundTransparency = 0.5 })
pulseTween:Play()
