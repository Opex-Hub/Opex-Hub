-- Slide-in Entrance Animation
local containerTween = TweenService:Create(
    container,
    TweenInfo.new(0.8, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
    { Position = UDim2.new(0.5, 0, 0.5, 0) }
