-- // UTILITY FUNCTIONS //
local function getGunDrop()
    if Workspace:FindFirstChild("GunDrop") then
        return Workspace.GunDrop
    end
    for _, v in pairs(Workspace:GetDescendants()) do
        if v.Name == "GunDrop" and v:IsA("BasePart") then
            return v
        end
    end
    return nil
end

local function getRole(player)
    if not player or not player.Character then return "Innocent" end
    if player.Character:FindFirstChild("Knife") then return "Murderer" end
    if player.Character:FindFirstChild("Gun") then return "Sheriff" end
    local bp = player:FindFirstChild("Backpack")
    if bp then
        if bp:FindFirstChild("Knife") then return "Murderer" end
        if bp:FindFirstChild("Gun") then return "Sheriff" end
    end
    return "Innocent"
end

local function getPlayerByRole(roleName)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and getRole(p) == roleName then
            return p
        end
    end
    return nil
end

local function create4LineCrosshair(parentFrame, color)
    local t = Instance.new("Frame") t.BackgroundColor3 = color t.BorderSizePixel = 0 t.Parent = parentFrame
    t.Size = UDim2.new(0, 3, 0, 12) t.Position = UDim2.new(0.5, -1, 0, 0)
    local b = Instance.new("Frame") b.BackgroundColor3 = color b.BorderSizePixel = 0 b.Parent = parentFrame
    b.Size = UDim2.new(0, 3, 0, 12) b.Position = UDim2.new(0.5, -1, 1, -12)
    local l = Instance.new("Frame") l.BackgroundColor3 = color l.BorderSizePixel = 0 l.Parent = parentFrame
    l.Size = UDim2.new(0, 12, 0, 3) l.Position = UDim2.new(0, 0, 0.5, -1)
    local r = Instance.new("Frame") r.BackgroundColor3 = color r.BorderSizePixel = 0 r.Parent = parentFrame
    r.Size = UDim2.new(0, 12, 0, 3) r.Position = UDim2.new(1, -12, 0.5, -1)
end

