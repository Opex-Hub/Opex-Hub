-- // AUTO FARM TAB //
AutoFarmTab:Section({ Title = "Coin Collectors" })

AutoFarmTab:Toggle({
    Title = "Auto Farm Coins",
    Desc = "Smoothly moves to coins and collects them automatically",
    Default = false,
    Callback = function(state)
        getgenv().OPEX.AutoFarmCoins = state
        task.spawn(function()
            while getgenv().OPEX.AutoFarmCoins do
                task.wait(0.2)
                if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    -- skip
                else
                    local root = LocalPlayer.Character.HumanoidRootPart
                    local coins = {}

                    -- Find all coin-like BaseParts on the ground (Y < 50)
                    for _, v in ipairs(Workspace:GetDescendants()) do
                        if v:IsA("BasePart") then
                            local name = v.Name:lower()
                            local parentName = v.Parent and v.Parent.Name:lower() or ""
                            if (name:find("coin") or parentName:find("coin")) and v.Position.Y < 50 then
                                table.insert(coins, v)
                            end
                        end
                    end

                    if #coins == 0 then
                        task.wait(1)
                    else
                        -- Sort by distance
                        table.sort(coins, function(a, b)
                            local distA = (root.Position - a.Position).Magnitude
                            local distB = (root.Position - b.Position).Magnitude
                            return distA < distB
                        end)

                        -- Tween to each coin (fast, safe)
                        for _, coin in ipairs(coins) do
                            if not getgenv().OPEX.AutoFarmCoins then break end
                            if coin and coin.Parent then
                                local distance = (root.Position - coin.Position).Magnitude
                                local speed = 60 -- studs per second, not too fast to kick
                                local duration = math.max(0.1, distance / speed)
                                local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
                                local tween = TweenService:Create(root, tweenInfo, {CFrame = coin.CFrame})
                                tween:Play()
                                tween.Completed:Wait()
                                
                                task.wait(0.05)
                                if firetouchinterest then
                                    firetouchinterest(root, coin, 0)
                                    task.wait(0.05)
                                    firetouchinterest(root, coin, 1)
                                end
                                task.wait(0.1)
                            end
                        end
                    end
                end
            end
        end)
    end
})


