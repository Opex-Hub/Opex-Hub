local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")

-- Remove previous instance to prevent overlapping
if playerGui:FindFirstChild("UpdatingOverlay") then
    playerGui.UpdatingOverlay:Destroy()
end

-- 1. ScreenGui Setup (True 1:1 Fullscreen)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "UpdatingOverlay"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 999
screenGui.Parent = playerGui

-- 2. Animated Background Image (ZIndex = 1)
local bgImage = Instance.new("ImageLabel")
bgImage.Size = UDim2.new(1, 0, 1, 0)
bgImage.Position = UDim2.new(0, 0, 0, 0)
bgImage.Image = "rbxassetid://10950346376" -- Anime background asset ID
bgImage.ScaleType = Enum.ScaleType.Crop
bgImage.BackgroundColor3 = Color3.fromRGB(10, 10, 18)
bgImage.BorderSizePixel = 0
bgImage.ZIndex = 1
bgImage.Parent = screenGui

-- Subtle background breathing animation loop
task.spawn(function()
    local t = 0
    while bgImage and bgImage.Parent do
        t = t + RunService.RenderStepped:Wait()
        local scale = 1 + math.sin(t * 0.5) * 0.02
        bgImage.Size = UDim2.new(scale, 0, scale, 0)
        bgImage.Position = UDim2.new((1 - scale)/2, 0, (1 - scale)/2, 0)
    end
end)

-- Dark Gradient Overlay (ZIndex = 2)
local gradientOverlay = Instance.new("Frame")
gradientOverlay.Size = UDim2.new(1, 0, 1, 0)
gradientOverlay.BackgroundColor3 = Color3.fromRGB(5, 5, 12)
gradientOverlay.BackgroundTransparency = 0.35
gradientOverlay.BorderSizePixel = 0
gradientOverlay.ZIndex = 2
gradientOverlay.Parent = bgImage

