                Btn.Position = UDim2.new(0.82, 0, 0.45, 0)
                Btn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
                Btn.Active = true
                Btn.Draggable = true

                local Corner = Instance.new("UICorner")
                Corner.CornerRadius = UDim.new(0, 16)
                Corner.Parent = Btn

                local Stroke = Instance.new("UIStroke")
                Stroke.Color = Color3.fromRGB(0, 140, 255)
                Stroke.Thickness = 2.5
                Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                Stroke.Parent = Btn

                local AimIcon = Instance.new("Frame")
                AimIcon.Name = "AimIcon"
                AimIcon.Parent = Btn
                AimIcon.Size = UDim2.new(0, 36, 0, 36)
                AimIcon.Position = UDim2.new(0.5, -18, 0.5, -18)
                AimIcon.BackgroundTransparency = 1
                
                create4LineCrosshair(AimIcon, Color3.fromRGB(0, 170, 255))

                RotateConnection = RunService.RenderStepped:Connect(function()
                    AimIcon.Rotation = (AimIcon.Rotation + 4) % 360
                end)

                Btn.MouseButton1Click:Connect(function()
                    getgenv().OPEX.IsShooting = true
                    task.delay(1, function()
                        getgenv().OPEX.IsShooting = false
                    end)

                    local murderer = getPlayerByRole("Murderer")
                    if murderer and murderer.Character and murderer.Character:FindFirstChild("Head") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local gun = LocalPlayer.Character:FindFirstChild("Gun") or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Gun"))
                        if gun then
                            gun.Parent = LocalPlayer.Character
                            task.wait(0.1)
                            
                            local targetHead = murderer.Character.Head.Position
                            -- Aim instantly
                            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(LocalPlayer.Character.HumanoidRootPart.Position, targetHead)
                            if Workspace.CurrentCamera then
                                Workspace.CurrentCamera.CFrame = CFrame.new(Workspace.CurrentCamera.CFrame.Position, targetHead)
                            end
                            task.wait(0.3) -- allow aim to stabilize

                            -- Try to fire via remote events/functions
                            local fired = false
                            for _, v in pairs(gun:GetDescendants()) do
                                if v:IsA("RemoteEvent") and (string.match(string.lower(v.Name), "shoot") or string.match(string.lower(v.Name), "fire") or string.match(string.lower(v.Name), "gun")) then
                                    v:FireServer(targetHead)
                                    fired = true
                                    break
                                elseif v:IsA("RemoteFunction") and (string.match(string.lower(v.Name), "shoot") or string.match(string.lower(v.Name), "fire") or string.match(string.lower(v.Name), "gun")) then
                                    task.spawn(function() v:InvokeServer(targetHead) end)
                                    fired = true
                                    break
                                end
                            end

                            -- If no remote, simulate click at murderer's head screen position
                            if not fired then
                                gun:Activate()
                                task.wait(0.1)
                                local cam = Workspace.CurrentCamera
                                local screenPos, onScreen = cam:WorldToScreenPoint(targetHead)
                                if onScreen then
                                    VirtualInputManager:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, true, game, 0)
                                    task.wait(0.1)
                                    VirtualInputManager:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, false, game, 0)
                                else
                                    -- Fallback: click center
                                    local viewSize = cam.ViewportSize
                                    VirtualInputManager:SendMouseButtonEvent(viewSize.X/2, viewSize.Y/2, 0, true, game, 0)
                                    task.wait(0.1)
                                    VirtualInputManager:SendMouseButtonEvent(viewSize.X/2, viewSize.Y/2, 0, false, game, 0)
                                end
                            end

                            -- Extra fallback: use mouse1click if available
                            if not fired and mouse1click then
                                mouse1click()
                            end
                        end
                    end
                end)
            end
        else
            if ShootGui then ShootGui:Destroy() ShootGui = nil end
            if RotateConnection then RotateConnection:Disconnect() RotateConnection = nil end
            getgenv().OPEX.IsShooting = false
        end
    end
})

