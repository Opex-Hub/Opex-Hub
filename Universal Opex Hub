-- Core Game Logic Helpers
local function GetPlayerRole(player)
    if not player or not player.Character then return "Innocent", Config.ESPColors.Innocent end
    local backpack = player:FindFirstChild("Backpack")
    local char = player.Character

    if (backpack and backpack:FindFirstChild("Knife")) or char:FindFirstChild("Knife") then
        return "Murderer", Config.ESPColors.Murderer
    elseif (backpack and (backpack:FindFirstChild("Gun") or backpack:FindFirstChild("Revolver"))) or char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") then
        return "Sheriff", Config.ESPColors.Sheriff
    elseif (backpack and backpack:FindFirstChild("Luger")) or char:FindFirstChild("Luger") then
        return "Hero", Config.ESPColors.Hero
    end
    return "Innocent", Config.ESPColors.Innocent
end

local function GetDroppedGun()
    local normal = Workspace:FindFirstChild("Normal")
    if normal then
        for _, obj in pairs(normal:GetChildren()) do
            if obj.Name == "GunDrop" or obj.Name == "Revolver" then
                return obj
            end
        end
    end
    return nil
end

local function ClearESP()
    for _, obj in pairs(Cache.ESPDrawings) do obj:Remove() end
    for _, obj in pairs(Cache.Highlights) do obj:Destroy() end
    table.clear(Cache.ESPDrawings)
    table.clear(Cache.Highlights)
end

-- ESP Render Loop
RunService.RenderStepped:Connect(function()
    ClearESP()
    if not Config.ESP.Enabled then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local hrp = player.Character.HumanoidRootPart
            local role, color = GetPlayerRole(player)
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            local distance = math.floor((Camera.CFrame.Position - hrp.Position).Magnitude)

            if Config.ESP.Chams then
                local highlight = Instance.new("Highlight")
                highlight.FillColor = color
                highlight.OutlineColor = Color3.new(1, 1, 1)
                highlight.FillTransparency = 0.5
                highlight.Parent = player.Character
                table.insert(Cache.Highlights, highlight)
            end

            if onScreen then
                if Config.ESP.Tracers then
                    local tracer = Drawing.new("Line")
                    tracer.Color = color
                    tracer.Thickness = 1.5
                    tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    tracer.To = Vector2.new(pos.X, pos.Y)
                    tracer.Visible = true
                    table.insert(Cache.ESPDrawings, tracer)
                end

                if Config.ESP.Names or Config.ESP.Roles then
                    local text = Drawing.new("Text")
                    text.Size = 14
                    text.Center = true
                    text.Outline = true
                    text.Color = color
                    text.Position = Vector2.new(pos.X, pos.Y - 35)
                    text.Text = (Config.ESP.Names and player.Name or "") .. " [" .. role .. "]"
                    text.Visible = true
                    table.insert(Cache.ESPDrawings, text)
                end
            end
        end
    end
end)

